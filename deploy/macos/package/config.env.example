# Copy this file to config.env and edit it before starting the Hub.
BESZEL_HTTP="127.0.0.1:8090"
APP_URL="http://127.0.0.1:8090"
BESZEL_DATA_DIR="$HOME/Library/Application Support/oh-my-beszel"
SSH_CONFIG_PATH="$HOME/.ssh/config"
CHECK_UPDATES="false"

# Optional: these initialize only a new database. Leave AUTO_LOGIN unset for
# normal password authentication, especially when exposing the Hub remotely.
# USER_EMAIL="admin@example.com"
# USER_PASSWORD="replace-with-a-unique-password"
# AUTO_LOGIN="admin@example.com"
